{
 "name": "oab-studio",
 "productName": "OAB Studio",
 "version": "1.0.12",
 "description": "OAB – On Air Broadcast",
 "author": "AD SOUND & SERVICE",
 "main": "main.js",
 "private": true,
 "devDependencies": {
  "electron": "^33.4.11",
  "electron-builder": "^25.1.8",
  "pe-library": "^2.0.3",
  "resedit": "^2.0.3"
 },
 "dependencies": {
  "electron-updater": "^6.8.11"
 },
 "build": {
  "appId": "com.adsound.oab",
  "productName": "OAB Studio",
  "copyright": "AD SOUND & SERVICE",
  "directories": {
   "output": "dist",
   "buildResources": "build"
  },
  "files": [
   "main.js",
   "build/icon.ico",
   "build/icon.png",
   "package.json",
   "preload.js",
   "splash/**"
  ],
  "extraResources": [
   {
    "from": "../server",
    "to": "server",
    "filter": [
     "**/*",
     "!dev/**",
     "!web/core.js",
     "!web/phases.js",
     "!web/studio.tpl.html",
     "!**/__pycache__/**"
    ]
   },
   {
    "from": "resources/python",
    "to": "python"
   },
   {
    "from": "scripts",
    "to": "scripts",
    "filter": [
     "**/*"
    ]
   }
  ],
  "asar": true,
  "win": {
   "target": [
    {
     "target": "nsis",
     "arch": [
      "x64"
     ]
    }
   ],
   "icon": "build/icon.ico",
   "artifactName": "OAB-Studio-Setup-${version}.${ext}",
   "signAndEditExecutable": false
  },
  "nsis": {
   "oneClick": false,
   "perMachine": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": "always",
   "createStartMenuShortcut": true,
   "shortcutName": "OAB Studio",
   "installerIcon": "build/icon.ico",
   "uninstallerIcon": "build/icon.ico",
   "installerHeaderIcon": "build/icon.ico",
   "runAfterFinish": true,
   "deleteAppDataOnUninstall": false
  },
  "publish": [
   {
    "provider": "github",
    "owner": "aviadderi1",
    "repo": "OAB-"
   }
  ],
  "afterPack": "./afterPack.js"
 },
 "scripts": {
  "start": "electron .",
  "pack": "electron-builder --win --dir --x64"
 }
}
